# Αντιγράψτε το σε .env (το .env δεν μπαίνει στο git) και αλλάξτε τις τιμές αν θέλετε.
# Placeholder για τοπική χρήση μόνο - όχι πραγματικός κωδικός.
POSTGRES_PASSWORD=local_dev_only
HOTEL_DB_PORT=5433

# --- Εκδοχή MySQL (docker compose --profile mysql ...) ---
# Placeholders για τοπική χρήση μόνο - όχι πραγματικοί κωδικοί. Ισχύουν από την ΠΡΩΤΗ εκκίνηση.
MYSQL_ROOT_PASSWORD=local_dev_only
# Κωδικός του χρήστη hotel_app, με τον οποίο συνδέεται η web εφαρμογή στη βάση.
MYSQL_PASSWORD=local_dev_only
HOTEL_MYSQL_PORT=3307
HOTEL_PMA_PORT=8081
HOTEL_WEB_PORT=8080
# Ο πρώτος χρήστης της web εφαρμογής (δημιουργείται μόνο όταν ο πίνακας app_user είναι άδειος).
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=local_dev_only
